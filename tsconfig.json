{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // La compilación de PRODUCCIÓN (`tsc && vite build`) no debe depender del
  // corredor de pruebas: `tsc` typechequeaba los `*.test.ts`, que importan
  // `vitest`, y el despliegue reventaba con «Cannot find module 'vitest'» en
  // cuanto el servidor no instalaba las dependencias de desarrollo. Las
  // pruebas las typechequea vitest, que sí las conoce.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
